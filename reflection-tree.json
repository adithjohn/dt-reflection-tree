[
  { "id": "START", "type": "start", "text": "Good evening. Let's take a structured look at your day." },

  { "id": "A1_OPEN", "parentId": "START", "type": "question",
    "text": "How would you describe your day overall?",
    "options": ["Productive","Mixed","Frustrating","Draining"]
  },

  { "id": "A1_ROUTE", "parentId": "A1_OPEN", "type": "decision",
    "rules": [
      { "if": "A1_OPEN.answer in ['Productive','Mixed']", "goTo": "A1_Q1_HIGH" },
      { "if": "True", "goTo": "A1_Q1_LOW" }
    ]
  },

  { "id": "A1_Q1_HIGH", "parentId": "A1_ROUTE", "type": "question",
    "text": "When something didn’t go as planned, what did you do first?",
    "options": ["Adjusted my approach","Waited for more clarity","Pushed through as is","Looked for help"],
    "signal": ["axis1:internal","axis1:external","axis1:external","axis1:internal"]
  },

  { "id": "A1_Q1_LOW", "parentId": "A1_ROUTE", "type": "question",
    "text": "When things weren’t going well, what did you tend to do?",
    "options": ["Tried to regain control","Waited for things to change","Kept going without changing much","Looked for support"],
    "signal": ["axis1:internal","axis1:external","axis1:external","axis1:internal"]
  },

  { "id": "A1_Q2_HIGH", "parentId": "A1_Q1_HIGH", "type": "question",
    "text": "Think about a specific challenge. What best describes your response?",
    "options": ["I changed my approach","I kept trying the same thing","I paused and waited","I asked for help and moved forward"],
    "signal": ["axis1:internal","axis1:external","axis1:external","axis1:internal"]
  },

  { "id": "A1_Q2_LOW", "parentId": "A1_Q1_LOW", "type": "question",
    "text": "Think about a specific challenge. What best describes your response?",
    "options": ["I changed my approach","I kept trying the same thing","I paused and waited","I asked for help and moved forward"],
    "signal": ["axis1:internal","axis1:external","axis1:external","axis1:internal"]
  },

  { "id": "A1_Q3_HIGH", "parentId": "A1_Q2_HIGH", "type": "question",
    "text": "What influenced that response the most?",
    "options": ["I knew what to do","I felt responsible","I wasn’t sure what to do","I didn’t feel it was my role"],
    "signal": ["axis1:internal","axis1:internal","axis1:external","axis1:external"]
  },

  { "id": "A1_Q3_LOW", "parentId": "A1_Q2_LOW", "type": "question",
    "text": "What influenced that response the most?",
    "options": ["I knew what to do","I felt responsible","I wasn’t sure what to do","I didn’t feel it was my role"],
    "signal": ["axis1:internal","axis1:internal","axis1:external","axis1:external"]
  },

  { "id": "A1_DECISION_HIGH", "parentId": "A1_Q3_HIGH", "type": "decision",
    "rules": [
      { "if": "axis1['internal'] > axis1['external']", "goTo": "A1_R_INT" },
      { "if": "axis1['internal'] < axis1['external']", "goTo": "A1_R_EXT" },
      { "if": "True", "goTo": "A1_R_MIXED" }
    ]
  },

  { "id": "A1_DECISION_LOW", "parentId": "A1_Q3_LOW", "type": "decision",
    "rules": [
      { "if": "axis1['internal'] > axis1['external']", "goTo": "A1_R_INT" },
      { "if": "axis1['internal'] < axis1['external']", "goTo": "A1_R_EXT" },
      { "if": "True", "goTo": "A1_R_MIXED" }
    ]
  },

  { "id": "A1_R_INT", "type": "reflection",
    "text": "You showed signs of taking control today — especially in how you responded to challenges.",
    "target": "BRIDGE_1_2"
  },

  { "id": "A1_R_EXT", "type": "reflection",
    "text": "Much of today may have felt shaped by external factors. Even so, small choices were still within reach.",
    "target": "BRIDGE_1_2"
  },

  { "id": "A1_R_MIXED", "type": "reflection",
    "text": "There were moments where you took control, and others where things felt outside your influence.",
    "target": "BRIDGE_1_2"
  },

  { "id": "BRIDGE_1_2", "type": "bridge",
    "text": "Now let’s shift from how you handled things to how you contributed.",
    "target": "A2_Q1"
  },

  { "id": "A2_Q1", "type": "question",
    "text": "In your interactions today, what best describes your approach?",
    "options": [
      "I stepped in where I could help",
      "I focused on doing my part well",
      "I ensured I met my responsibilities while others handled theirs",
      "I waited for direction"
    ],
    "signal": ["axis2:contribution","axis2:neutral","axis2:entitlement","axis2:entitlement"]
  },

  { "id": "A2_Q2", "parentId": "A2_Q1", "type": "question",
    "text": "How did you go beyond expectations?",
    "options": ["Took initiative","Did expected work","Stayed within role","Waited"],
    "signal": ["axis2:contribution","axis2:neutral","axis2:entitlement","axis2:entitlement"]
  },

  { "id": "A2_Q3", "parentId": "A2_Q2", "type": "question",
    "text": "What influenced your effort?",
    "options": ["Ownership","Efficiency","Not my role","Needed clarity"],
    "signal": ["axis2:contribution","axis2:neutral","axis2:entitlement","axis2:neutral"]
  },

  { "id": "A2_DECISION", "parentId": "A2_Q3", "type": "decision",
    "rules": [
      { "if": "axis2['contribution'] > axis2['entitlement']", "goTo": "A2_R_CONTRIB" },
      { "if": "axis2['contribution'] < axis2['entitlement']", "goTo": "A2_R_ENT" },
      { "if": "True", "goTo": "A2_R_NEUTRAL" }
    ]
  },

  { "id": "A2_R_CONTRIB", "type": "reflection", "text": "You leaned toward contributing beyond expectations.", "target": "BRIDGE_2_3" },
  { "id": "A2_R_ENT", "type": "reflection", "text": "You focused more on defined responsibilities today.", "target": "BRIDGE_2_3" },
  { "id": "A2_R_NEUTRAL", "type": "reflection", "text": "Your effort stayed balanced within expectations.", "target": "BRIDGE_2_3" },

  { "id": "BRIDGE_2_3", "type": "bridge",
    "text": "Finally, let’s expand the view beyond you and your immediate tasks.",
    "target": "A3_Q1"
  },

  { "id": "A3_Q1", "type": "question",
    "text": "What felt most central today?",
    "options": ["My tasks","My team","A colleague","The broader outcome"],
    "signal": ["axis3:self","axis3:team","axis3:individual","axis3:system"]
  },

  { "id": "A3_Q2", "parentId": "A3_Q1", "type": "question",
    "text": "Who did your work impact most?",
    "options": ["Myself","Team","One person","Customers"],
    "signal": ["axis3:self","axis3:team","axis3:individual","axis3:system"]
  },

  { "id": "A3_DECISION", "parentId": "A3_Q2", "type": "decision",
    "rules": [
      { "if": "axis3['system'] > axis3['team'] and axis3['system'] > axis3['self']", "goTo": "A3_R_SYSTEM" },
      { "if": "axis3['team'] >= axis3['self']", "goTo": "A3_R_TEAM" },
      { "if": "True", "goTo": "A3_R_SELF" }
    ]
  },

  { "id": "A3_R_SYSTEM", "type": "reflection", "text": "You focused on broader impact beyond yourself.", "target": "SUMMARY" },
  { "id": "A3_R_TEAM", "type": "reflection", "text": "You balanced team and personal impact.", "target": "SUMMARY" },
  { "id": "A3_R_SELF", "type": "reflection", "text": "Your focus stayed closer to your own work.", "target": "SUMMARY" },

  { "id": "SUMMARY", "type": "summary",
    "text": "You described today as '{A1_OPEN.answer}'. Your actions showed how you responded under pressure and how you contributed to others."
  },

  { "id": "END", "parentId": "SUMMARY", "type": "end",
    "text": "Reflection complete. See you tomorrow."
  }
]
